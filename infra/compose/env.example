# ==========================================
# BACKEND ENVIRONMENT VARIABLES TEMPLATE
# Không điền mật khẩu/token thật vào file này
# Copy file này thành .env và điền giá trị cụ thể
# ==========================================

NODE_ENV=production
PORT=8888

# JWT Secrets (Tạo chuỗi ngẫu nhiên bằng lệnh: openssl rand -base64 32)
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_min_32_chars
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# Domain & CORS
FRONTEND_URL=http://localhost:4000

# Database Connection
# Trong Docker Compose mạng nội bộ: mongodb://db:27017/yolohub
MONGODB_URI=mongodb://db:27017/yolohub

# External Services (Tùy chọn cho AI Chatbot & Thanh toán)
GEMINI_API_KEY=your_gemini_api_key_placeholder
SEPAY_API_KEY=your_sepay_api_key_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_CURRENCY=vnd

# Email SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=youremail@example.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=YoloHub
