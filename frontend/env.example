# ==========================================
# FRONTEND ENVIRONMENT VARIABLES TEMPLATE
# Không điền mật khẩu/token thật vào file này
# Copy file này thành .env và điền giá trị cụ thể
# ==========================================

NODE_ENV=production
PORT=4000
HOSTNAME=0.0.0.0

# API Backend Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8888/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:4000

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:4000
NEXTAUTH_SECRET=your_nextauth_secret_min_32_chars

# OAuth Providers (Google, Facebook)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret

# Upload & Payment (Tùy chọn)
UPLOADTHING_TOKEN=your_uploadthing_token_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

